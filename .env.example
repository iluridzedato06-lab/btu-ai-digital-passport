# ---------------------------------------------------------------------------
# BTU AI Skills Digital Passport — environment
# Copy to .env (scripts/up does this automatically on first run).
# The values below are SAFE LOCAL DEFAULTS ONLY. Never use them in production.
# ---------------------------------------------------------------------------

# Django
DJANGO_DEBUG=false
SECRET_KEY=local-dev-only-change-me-0f6c1d9b8a7e4c2f9d3b5a1e7c8d9f0a
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SECURE_COOKIES=false
BEHIND_TLS_PROXY=false
NUM_PROXIES=1
LOG_LEVEL=INFO

# Who may sign in (comma separated domains) and who becomes admin on first sign-in
ALLOWED_EMAIL_DOMAINS=btu.edu.ge
ADMIN_BOOTSTRAP_EMAILS=passport.admin@btu.edu.ge

# Seed the 3 showcase students into the local sheet on first start
SEED_DEMO_ON_START=true

# Data source: local_xlsx (data/local_sheet/passport_sheet.xlsx) or google
SHEETS_ADAPTER=local_xlsx
SYNC_INTERVAL_SECONDS=30
SYNC_AUTO_WITHDRAW=false
# Google Sheets (only when SHEETS_ADAPTER=google). See docs/GOOGLE_SHEETS.md
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Email (Mailpit catches everything locally: http://localhost:8025)
DEFAULT_FROM_EMAIL=BTU AI Skills Passport <passport@btu.edu.ge>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# Blockchain — local Anvil chain (default). Keys are Anvil's public test accounts #0 and #1.
CHAIN_ENABLED=true
CHAIN_RPC_URL=http://anvil:8545
CHAIN_ID=31337
CHAIN_NAME=Anvil local chain (development)
CONTRACT_ADDRESS=
AUTO_DEPLOY_CONTRACT=true
CHAIN_OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHAIN_ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
EXPLORER_TX_URL=
EXPLORER_ADDRESS_URL=

# --- Polygon Amoy testnet (uncomment, fund the issuer from https://faucet.polygon.technology) ---
# CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# CHAIN_ID=80002
# CHAIN_NAME=Polygon Amoy testnet
# AUTO_DEPLOY_CONTRACT=false
# CHAIN_OWNER_PRIVATE_KEY=0x...
# CHAIN_ISSUER_PRIVATE_KEY=0x...
# EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/{}
# EXPLORER_ADDRESS_URL=https://amoy.polygonscan.com/address/{}
